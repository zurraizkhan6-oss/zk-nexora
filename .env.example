# FRONTEND config — copy to .env (these values are PUBLIC; never put secrets here)

# Your final public URL (enables canonical + og:url), e.g. https://yourdomain.com
VITE_SITE_URL=

# WhatsApp number in international format, digits only (e.g. 15551234567). Empty = button shows a "not set up" note.
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_MESSAGE=Hello ZK NEXORA, I'd like to talk about a project.

# Contact form endpoint. Either a Formspree-style URL or your deployed server, e.g. https://api.yourdomain.com/api/contact
VITE_CONTACT_ENDPOINT=

# Optional AI chat proxy, e.g. https://api.yourdomain.com/api/chat  (empty = built-in demo assistant)
VITE_CHAT_API_URL=

# Optional public email to display in footer/contact section
VITE_CONTACT_EMAIL=

# Founder photo path inside /public, e.g. /founder/zurraiz.jpg (empty = placeholder)
VITE_FOUNDER_PHOTO=
