# SERVER-SIDE secrets — copy to server/.env (never commit it, never expose it to the frontend)
PORT=8787
# Your website origin allowed to call this API from the browser, e.g. https://yourdomain.com
ALLOWED_ORIGIN=
# Set to true only if running behind a trusted reverse proxy (so rate limiting sees real client IPs)
TRUST_PROXY=false

# Contact form email delivery (Resend — https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# AI chatbot (any OpenAI-compatible chat completions API)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
